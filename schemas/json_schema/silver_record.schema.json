{
  "$defs": {
    "SilverSegment": {
      "additionalProperties": false,
      "description": "One included prose segment evaluated by CPU quality models.",
      "properties": {
        "role": {
          "default": "other",
          "enum": [
            "abstract",
            "introduction",
            "background",
            "methods",
            "results",
            "discussion",
            "conclusion",
            "limitations",
            "appendix",
            "acknowledgements",
            "references",
            "metadata",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "word_count": {
          "default": 0,
          "minimum": 0,
          "title": "Word Count",
          "type": "integer"
        }
      },
      "required": [
        "segment_id",
        "title",
        "text"
      ],
      "title": "SilverSegment",
      "type": "object"
    },
    "SilverTags": {
      "additionalProperties": false,
      "description": "Heuristic tagger outputs and perplexity score.",
      "properties": {
        "c4_nopunc_pass": {
          "description": "Passed the C4 fraction-of-lines-without-punctuation filter.",
          "title": "C4 Nopunc Pass",
          "type": "boolean"
        },
        "gopher_pass": {
          "description": "Passed the Gopher quality filter.",
          "title": "Gopher Pass",
          "type": "boolean"
        },
        "perplexity": {
          "description": "KenLM perplexity (lower is more typical text).",
          "minimum": 0.0,
          "title": "Perplexity",
          "type": "number"
        },
        "perplexity_bucket": {
          "enum": [
            "head",
            "middle",
            "tail"
          ],
          "title": "Perplexity Bucket",
          "type": "string"
        }
      },
      "required": [
        "gopher_pass",
        "c4_nopunc_pass",
        "perplexity",
        "perplexity_bucket"
      ],
      "title": "SilverTags",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Normalized, language-tagged, heuristically-scored document.",
  "properties": {
    "citation_count": {
      "default": 0,
      "minimum": 0,
      "title": "Citation Count",
      "type": "integer"
    },
    "doc_id": {
      "description": "Content-addressed document id, sha256 of the canonical URL.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Doc Id",
      "type": "string"
    },
    "equation_count": {
      "default": 0,
      "minimum": 0,
      "title": "Equation Count",
      "type": "integer"
    },
    "excluded_section_count": {
      "default": 0,
      "minimum": 0,
      "title": "Excluded Section Count",
      "type": "integer"
    },
    "excluded_sections": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Sections",
      "type": "array"
    },
    "extracted_with": {
      "description": "Extractor identity + version, e.g. 'resiliparse-0.14'.",
      "title": "Extracted With",
      "type": "string"
    },
    "extraction_pipeline": {
      "default": "resiliparse-0.14",
      "description": "Operator-chain identifier of the extractor that produced ``text``. Distinct from ``extracted_with`` so a single extractor binary can ship multiple named pipelines (e.g. 'arxiv-html-2026-06' vs 'fineweb-edu-html').",
      "maxLength": 128,
      "minLength": 1,
      "title": "Extraction Pipeline",
      "type": "string"
    },
    "extraction_warnings": {
      "items": {
        "type": "string"
      },
      "title": "Extraction Warnings",
      "type": "array"
    },
    "figure_count": {
      "default": 0,
      "minimum": 0,
      "title": "Figure Count",
      "type": "integer"
    },
    "included_section_count": {
      "default": 0,
      "minimum": 0,
      "title": "Included Section Count",
      "type": "integer"
    },
    "lang": {
      "description": "ISO 639-1/3 language code.",
      "maxLength": 8,
      "minLength": 2,
      "title": "Lang",
      "type": "string"
    },
    "lang_detector_revision": {
      "default": "unknown",
      "title": "Lang Detector Revision",
      "type": "string"
    },
    "lang_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Lang Score",
      "type": "number"
    },
    "minhash_backend": {
      "default": "rensa",
      "description": "Identity of the MinHash backend that produced ``minhash_sig`` (rensa | datasketch | pure-python). Consumers MUST refuse to LSH-band a signature whose backend differs from the one their in-process MinHasher expects, because the per-permutation byte layout is not interchangeable across backends.",
      "title": "Minhash Backend",
      "type": "string"
    },
    "minhash_num_perms": {
      "default": 112,
      "description": "Number of permutations packed into ``minhash_sig``.",
      "minimum": 1,
      "title": "Minhash Num Perms",
      "type": "integer"
    },
    "minhash_sig": {
      "description": "Binary MinHash signature, 112 permutations packed little-endian.",
      "format": "base64url",
      "title": "Minhash Sig",
      "type": "string"
    },
    "model_text": {
      "default": "",
      "description": "Body-only prose used by web-quality, KenLM, PII, and dedup stages. Scientific equations/tables/figures remain in text but are excluded here.",
      "title": "Model Text",
      "type": "string"
    },
    "near_dup_cluster_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set by the LSHBloom operator; None for first occurrence in band.",
      "title": "Near Dup Cluster Id"
    },
    "projection_version": {
      "default": "document-v1",
      "title": "Projection Version",
      "type": "string"
    },
    "scientific_artifact_s3_uri": {
      "anyOf": [
        {
          "pattern": "^s3://[^/]+/.+",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Structured sections/tables/equations/figures JSON artifact.",
      "title": "Scientific Artifact S3 Uri"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/SilverSegment"
      },
      "title": "Segments",
      "type": "array"
    },
    "source_feed": {
      "default": "unknown",
      "description": "SourceFeed CRD name propagated from Bronze.",
      "maxLength": 128,
      "minLength": 1,
      "title": "Source Feed",
      "type": "string"
    },
    "source_format": {
      "default": "html",
      "description": "Wire shape carried forward from the Bronze record.",
      "enum": [
        "html",
        "pdf",
        "latex",
        "code",
        "web",
        "metadata",
        "review"
      ],
      "title": "Source Format",
      "type": "string"
    },
    "source_metadata_text": {
      "default": "",
      "description": "Bounded title/author metadata scanned separately from trainable body text.",
      "maxLength": 32768,
      "title": "Source Metadata Text",
      "type": "string"
    },
    "source_word_count": {
      "default": 0,
      "minimum": 0,
      "title": "Source Word Count",
      "type": "integer"
    },
    "spdx_license": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "OSI-list verified SPDX id, or None if not attached.",
      "title": "Spdx License"
    },
    "spdx_license_source": {
      "default": "unknown",
      "description": "Where the SPDX id was read from.",
      "enum": [
        "github_api",
        "html_meta",
        "rss_entry",
        "oai_metadata",
        "arxiv_api",
        "dataset_metadata",
        "manual_override",
        "unknown"
      ],
      "title": "Spdx License Source",
      "type": "string"
    },
    "structured_text": {
      "default": "",
      "description": "Bounded tables/equations/figure surrogates appended after selected prose.",
      "title": "Structured Text",
      "type": "string"
    },
    "table_count": {
      "default": 0,
      "minimum": 0,
      "title": "Table Count",
      "type": "integer"
    },
    "tags": {
      "$ref": "#/$defs/SilverTags"
    },
    "text": {
      "description": "Extracted plain text (Resiliparse output).",
      "title": "Text",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "trace_id": {
      "description": "W3C trace-id (lowercase hex, 32 chars).",
      "pattern": "^[0-9a-f]{32}$",
      "title": "Trace Id",
      "type": "string"
    },
    "training_usage": {
      "default": "pretrain_and_posttrain",
      "description": "Purpose boundary propagated from the pre-fetch licence decision.",
      "enum": [
        "pretrain_and_posttrain",
        "posttrain_transform_only"
      ],
      "title": "Training Usage",
      "type": "string"
    },
    "training_word_count": {
      "default": 0,
      "minimum": 0,
      "title": "Training Word Count",
      "type": "integer"
    },
    "url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Url",
      "type": "string"
    },
    "valid_from": {
      "description": "Inclusive start of the document's validity interval.",
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_from_source": {
      "enum": [
        "http_last_modified",
        "schema_org_date_published",
        "sitemap_lastmod",
        "wayback_first_seen",
        "license_effective_date",
        "fetched_at",
        "dataset_metadata",
        "release_published_at"
      ],
      "title": "Valid From Source",
      "type": "string"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Exclusive end of the validity interval; None means open-ended.",
      "title": "Valid To"
    }
  },
  "required": [
    "doc_id",
    "url",
    "text",
    "lang",
    "lang_score",
    "extracted_with",
    "tags",
    "minhash_sig",
    "valid_from",
    "valid_from_source",
    "trace_id"
  ],
  "title": "SilverRecord",
  "type": "object"
}
