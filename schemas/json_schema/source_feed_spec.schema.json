{
  "$defs": {
    "AuthSpec": {
      "additionalProperties": false,
      "description": "Reference to a Secret holding the auth token.",
      "properties": {
        "headerName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headername"
        },
        "secretKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secretkey"
        },
        "secretName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secretname"
        },
        "type": {
          "default": "none",
          "enum": [
            "none",
            "bearer",
            "header",
            "basic"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "title": "AuthSpec",
      "type": "object"
    },
    "RateLimitSpec": {
      "additionalProperties": false,
      "description": "Politeness limits for a single SourceFeed.",
      "properties": {
        "burst": {
          "exclusiveMinimum": 0,
          "title": "Burst",
          "type": "integer"
        },
        "requestsPerSecond": {
          "exclusiveMinimum": 0.0,
          "title": "Requestspersecond",
          "type": "number"
        },
        "respectXPollInterval": {
          "default": false,
          "description": "If true, the poller defers to the response's X-Poll-Interval header.",
          "title": "Respectxpollinterval",
          "type": "boolean"
        }
      },
      "required": [
        "requestsPerSecond",
        "burst"
      ],
      "title": "RateLimitSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Spec of a single SourceFeed CRD instance.",
  "properties": {
    "acceptContentTypes": {
      "items": {
        "type": "string"
      },
      "title": "Acceptcontenttypes",
      "type": "array"
    },
    "auth": {
      "$ref": "#/$defs/AuthSpec"
    },
    "egressAllow": {
      "description": "Hostnames the SourceFeed pod may dial (NetworkPolicy egress).",
      "items": {
        "type": "string"
      },
      "title": "Egressallow",
      "type": "array"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "endpoint": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Endpoint",
      "type": "string"
    },
    "licenseDefault": {
      "default": "unknown",
      "enum": [
        "per-record",
        "arxiv-non-exclusive-distribution",
        "unknown",
        "CC-BY-4.0",
        "CC-BY-SA-4.0",
        "CC-BY-3.0",
        "CC-BY-SA-3.0",
        "CC0-1.0",
        "Apache-2.0",
        "MIT",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "MPL-2.0",
        "ISC",
        "Unlicense"
      ],
      "title": "Licensedefault",
      "type": "string"
    },
    "name": {
      "maxLength": 63,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "pollIntervalSeconds": {
      "exclusiveMinimum": 0,
      "maximum": 86400,
      "title": "Pollintervalseconds",
      "type": "integer"
    },
    "protocol": {
      "enum": [
        "rss",
        "atom",
        "oai-pmh",
        "rest-json",
        "sitemap",
        "manual"
      ],
      "title": "Protocol",
      "type": "string"
    },
    "rateLimit": {
      "$ref": "#/$defs/RateLimitSpec"
    }
  },
  "required": [
    "name",
    "protocol",
    "endpoint",
    "pollIntervalSeconds",
    "rateLimit"
  ],
  "title": "SourceFeedSpec",
  "type": "object"
}
