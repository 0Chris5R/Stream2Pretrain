{
  "additionalProperties": false,
  "description": "One purpose-aware licence decision made before content retrieval.",
  "properties": {
    "content_fetch_started": {
      "const": false,
      "default": false,
      "title": "Content Fetch Started",
      "type": "boolean"
    },
    "decision_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Decision Id",
      "type": "string"
    },
    "doc_id": {
      "description": "Stable document-revision id. Usually the sha256 of the canonical URL; exact content projections may bind an immutable source object.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Doc Id",
      "type": "string"
    },
    "evidence_revision": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Revision"
    },
    "evidence_scope": {
      "default": "unknown",
      "enum": [
        "item",
        "file",
        "repository_ref",
        "source_terms",
        "dataset_wrapper",
        "unknown"
      ],
      "title": "Evidence Scope",
      "type": "string"
    },
    "evidence_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Url"
    },
    "license_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "License Id",
      "type": "string"
    },
    "license_source": {
      "maxLength": 64,
      "minLength": 1,
      "title": "License Source",
      "type": "string"
    },
    "normalized_license": {
      "default": "unknown",
      "maxLength": 128,
      "minLength": 1,
      "title": "Normalized License",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "policy_revision": {
      "default": "license-policy-legacy",
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Revision",
      "type": "string"
    },
    "raw_license": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw License"
    },
    "reason": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "resolved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved At"
    },
    "resolver": {
      "default": "legacy",
      "maxLength": 128,
      "minLength": 1,
      "title": "Resolver",
      "type": "string"
    },
    "source_feed": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source Feed",
      "type": "string"
    },
    "source_format": {
      "anyOf": [
        {
          "enum": [
            "html",
            "pdf",
            "latex",
            "markdown",
            "web",
            "metadata"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Format"
    },
    "source_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Source Url",
      "type": "string"
    },
    "status": {
      "enum": [
        "admitted",
        "posttrain_transform_only",
        "quarantined"
      ],
      "title": "Status",
      "type": "string"
    },
    "trace_id": {
      "description": "W3C trace-id (lowercase hex, 32 chars).",
      "pattern": "^[0-9a-f]{32}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "doc_id",
    "source_feed",
    "source_url",
    "observed_at",
    "status",
    "license_id",
    "license_source",
    "reason",
    "trace_id"
  ],
  "title": "LicenseAdmissionDecision",
  "type": "object"
}
