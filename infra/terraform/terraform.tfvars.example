# Copy to terraform.tfvars and adjust if DHBWCloud changes image/flavor names.
# terraform.tfvars is gitignored.

# Defaults mirror the working demo project in ~/DHBW/cloud.
cluster_name = "stream2pretrain"
network_name = "DHBWV6"
ip_family    = "ipv6"

# Ubuntu Server image id observed in the demo Terraform.
image_id = "7842eb53-0ac7-4677-9160-2466371b4302"

# Existing OpenStack keypair.
key_pair = "Julian"

# Sizing. `k8s.node` is the conservative demo default; benchmark on the actual
# cluster before increasing this.
control_flavor = "k8s.node"
worker_flavor  = "k8s.node"
worker_count   = 2

ssh_user           = "ubuntu"
interpreter_python = "/usr/bin/python3"
security_groups    = ["default"]

# availability_zone = "nova"
# extra_metadata = { owner = "dhbw-team" }
