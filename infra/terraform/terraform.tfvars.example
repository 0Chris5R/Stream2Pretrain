# Copy to terraform.tfvars and adjust if DHBWCloud changes image/flavor names.
# terraform.tfvars is gitignored.

# Values below describe the existing DHBW IPv6 network. Verify them against the
# target project before applying.
cluster_name = "stream2pretrain"
network_name = "DHBWV6"
ip_family    = "dual"

# Required project-specific inputs. Resolve these with the OpenStack CLI rather
# than copying another project member's identifiers.
image_id = "REPLACE_WITH_GLANCE_IMAGE_ID"

key_pair = "REPLACE_WITH_OPENSTACK_KEYPAIR"

# The current cluster was successfully provisioned with k8s.node. Changing the
# flavor or worker count requires a fresh capacity measurement and an explicit
# review because the resources are protected from replacement.
control_flavor = "k8s.node"
worker_flavor  = "k8s.node"
worker_count   = 2

ssh_user           = "ubuntu"
interpreter_python = "/usr/bin/python3"
security_groups    = ["default"]

# availability_zone = "nova"
# extra_metadata = { owner = "dhbw-team" }
