{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stream2Pretrain values",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "redpanda", "minio", "iceberg", "sources", "ingest", "processor", "ui", "keda", "observability"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "pullPolicy"],
      "properties": {
        "registry": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
        "pullSecrets": {"type": "array", "items": {"type": "string"}}
      }
    },
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "commonLabels": {"type": "object"},
    "commonAnnotations": {"type": "object"},
    "profile": {"type": "string", "enum": ["dev", "prod"]},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object"}
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"create": {"type": "boolean"}}
    },
    "redpanda": {
      "type": "object",
      "required": ["bootstrapServers", "startingOffset", "maxMessageBytes", "topics"],
      "properties": {
        "bootstrapServers": {"type": "string", "minLength": 1},
        "schemaRegistry": {"type": "string"},
        "startingOffset": {"type": "string", "const": "stored"},
        "maxMessageBytes": {"type": "integer", "minimum": 65537},
        "saslMechanism": {"type": "string"},
        "authSecret": {"type": "string"},
        "topics": {
          "type": "object",
          "required": ["rawFetched", "smokeRaw", "githubReleaseJobs", "docsNormalized", "docsNormalizedSmoke", "docsCurated", "docsCuratedSmoke", "curationDecisions", "curationDecisionsSmoke", "licenseAdmissions", "licenseAdmissionsSmoke", "deconAttest", "foundryJobs", "foundryEvents", "foundryArtifacts"],
          "properties": {
            "rawFetched": {"type": "string"},
            "smokeRaw": {"type": "string"},
            "githubReleaseJobs": {"type": "string"},
            "docsNormalized": {"type": "string"},
            "docsNormalizedSmoke": {"type": "string"},
            "docsCurated": {"type": "string"},
            "docsCuratedSmoke": {"type": "string"},
            "curationDecisions": {"type": "string"},
            "curationDecisionsSmoke": {"type": "string"},
            "licenseAdmissions": {"type": "string"},
            "licenseAdmissionsSmoke": {"type": "string"},
            "deconAttest": {"type": "string"},
            "foundryJobs": {"type": "string"},
            "foundryEvents": {"type": "string"},
            "foundryArtifacts": {"type": "string"}
          }
        }
      }
    },
    "minio": {
      "type": "object",
      "required": ["endpoint", "buckets", "credentialsSecret"],
      "properties": {
        "endpoint": {"type": "string", "format": "uri"},
        "region": {"type": "string"},
        "buckets": {
          "type": "object",
          "required": ["bronze", "silver", "gold", "decon", "posttrain", "state"],
          "properties": {
            "bronze": {"type": "string"},
            "silver": {"type": "string"},
            "gold": {"type": "string"},
            "decon": {"type": "string"},
            "posttrain": {"type": "string"},
            "state": {"type": "string"}
          }
        },
        "credentialsSecret": {"type": "string", "minLength": 1}
      }
    },
    "iceberg": {
      "type": "object",
      "required": ["catalog", "namespace", "goldTable", "decisionsTable", "licenseAdmissionsTable", "foundryEventsTable", "posttrainArtifactsTable", "polarisUrl", "warehouse", "credentialSecret", "credentialKey", "scopeKey", "branches"],
      "properties": {
        "catalog": {"type": "string"},
        "namespace": {"type": "string"},
        "goldTable": {"type": "string"},
        "decisionsTable": {"type": "string"},
        "licenseAdmissionsTable": {"type": "string"},
        "foundryEventsTable": {"type": "string"},
        "posttrainArtifactsTable": {"type": "string"},
        "polarisUrl": {"type": "string", "format": "uri"},
        "warehouse": {"type": "string"},
        "accessDelegation": {"type": "string", "enum": ["vended-credentials", "remote-signing", "none"]},
        "credentialSecret": {"type": "string"},
        "credentialKey": {"type": "string"},
        "scopeKey": {"type": "string"},
        "branches": {
          "type": "object",
          "required": ["main", "shadowA", "shadowB"],
          "properties": {
            "main": {"type": "string"},
            "shadowA": {"type": "string"},
            "shadowB": {"type": "string"}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "defaultDeny": {"type": "boolean"},
        "egressAllow": {"type": "object"},
        "dnsNamespace": {"type": "string"}
      }
    },
    "sources": {
      "type": "object",
      "required": ["arxiv", "github", "huggingface", "blogs"],
      "properties": {
        "arxiv": {
          "type": "object",
          "required": ["enabled", "oaiPmh", "rss"],
          "properties": {
            "enabled": {"type": "boolean"},
            "oaiPmh": {
              "type": "object",
              "required": ["name", "endpoint", "set", "pollIntervalSeconds", "schedule"],
              "properties": {
                "name": {"type": "string"},
                "endpoint": {"type": "string", "format": "uri"},
                "set": {"type": "string"},
                "pollIntervalSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
                "licenseDefault": {"type": "string", "enum": ["per-record"]},
                "kind": {"type": "string", "enum": ["cronjob", "deployment"]},
                "schedule": {"type": "string"}
              }
            },
            "rss": {
              "type": "object",
              "required": ["categories", "pollIntervalSeconds", "schedule"],
              "properties": {
                "categories": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                "pollIntervalSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
                "kind": {"type": "string", "enum": ["cronjob", "deployment"]},
                "schedule": {"type": "string"},
                "licenseDefault": {"type": "string", "enum": ["per-record"]}
              }
            },
            "htmlFetcher": {
              "type": "object",
              "required": ["enabled", "feedName"],
              "properties": {
                "enabled": {"type": "boolean"},
                "feedName": {"type": "string", "minLength": 1, "maxLength": 128},
                "backfill": {
                  "type": "object",
                  "required": ["enabled"],
                  "properties": {
                    "enabled": {"type": "boolean"},
                    "schedule": {"type": "string"},
                    "deadlineSeconds": {"type": "integer", "minimum": 60, "maximum": 86400},
                    "configMap": {"type": "string"}
                  }
                }
              }
            }
          }
        },
        "github": {
          "type": "object",
          "required": ["enabled", "events", "releases"],
          "properties": {
            "enabled": {"type": "boolean"},
            "events": {
              "type": "object",
              "required": ["name", "pollIntervalSeconds", "tokenSecret", "tokenSecretKey"],
              "properties": {
                "name": {"type": "string"},
                "pollIntervalSeconds": {"type": "integer", "minimum": 30, "maximum": 86400},
                "respectXPollInterval": {"type": "boolean"},
                "kind": {"type": "string", "enum": ["cronjob", "deployment"]},
                "tokenSecret": {"type": "string"},
                "tokenSecretKey": {"type": "string"},
                "aiOrgFilter": {"type": "array", "items": {"type": "string"}}
              }
            },
            "releases": {
              "type": "object",
              "required": ["name", "pollIntervalSeconds", "schedule", "tokenSecret", "tokenSecretKey", "repos"],
              "properties": {
                "name": {"type": "string"},
                "pollIntervalSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
                "kind": {"type": "string", "enum": ["cronjob", "deployment"]},
                "schedule": {"type": "string"},
                "tokenSecret": {"type": "string"},
                "tokenSecretKey": {"type": "string"},
                "repos": {"type": "array", "items": {"type": "string"}, "minItems": 1}
              }
            }
          }
        },
        "huggingface": {
          "type": "object",
          "required": ["enabled", "models", "datasets", "spaces", "dailyPapers"],
          "properties": {
            "enabled": {"type": "boolean"},
            "models": {
              "type": "object",
              "required": ["name", "endpoint", "pollIntervalSeconds", "tokenSecret", "tokenSecretKey"],
              "properties": {
                "name": {"type": "string"},
                "endpoint": {"type": "string", "format": "uri"},
                "pollIntervalSeconds": {"type": "integer", "minimum": 60, "maximum": 86400},
                "kind": {"type": "string", "enum": ["cronjob", "deployment"]},
                "tokenSecret": {"type": "string"},
                "tokenSecretKey": {"type": "string"}
              }
            },
            "datasets": {
              "type": "object",
              "required": ["name", "endpoint", "pollIntervalSeconds", "tokenSecret", "tokenSecretKey"],
              "properties": {
                "name": {"type": "string"},
                "endpoint": {"type": "string", "format": "uri"},
                "pollIntervalSeconds": {"type": "integer", "minimum": 60, "maximum": 86400},
                "kind": {"type": "string", "enum": ["cronjob", "deployment"]},
                "tokenSecret": {"type": "string"},
                "tokenSecretKey": {"type": "string"}
              }
            },
            "spaces": {
              "type": "object",
              "required": ["name", "endpoint", "pollIntervalSeconds", "tokenSecret", "tokenSecretKey"],
              "properties": {
                "name": {"type": "string"},
                "endpoint": {"type": "string", "format": "uri"},
                "pollIntervalSeconds": {"type": "integer", "minimum": 60, "maximum": 86400},
                "kind": {"type": "string", "enum": ["cronjob", "deployment"]},
                "tokenSecret": {"type": "string"},
                "tokenSecretKey": {"type": "string"}
              }
            },
            "dailyPapers": {
              "type": "object",
              "required": ["name", "endpoint", "pollIntervalSeconds", "schedule", "tokenSecret", "tokenSecretKey"],
              "properties": {
                "name": {"type": "string"},
                "endpoint": {"type": "string", "format": "uri"},
                "pollIntervalSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
                "kind": {"type": "string", "enum": ["cronjob", "deployment"]},
                "schedule": {"type": "string"},
                "tokenSecret": {"type": "string"},
                "tokenSecretKey": {"type": "string"}
              }
            }
          }
        },
        "blogs": {
          "type": "object",
          "required": ["enabled", "schedule", "feeds"],
          "properties": {
            "enabled": {"type": "boolean"},
            "pollIntervalSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
            "kind": {"type": "string", "enum": ["cronjob", "deployment"]},
            "schedule": {"type": "string"},
            "feeds": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "url"],
                "properties": {
                  "name": {"type": "string"},
                  "url": {"type": "string", "format": "uri"}
                }
              }
            }
          }
        },
        "sitemap": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "name": {"type": "string"},
            "pollIntervalSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
            "kind": {"type": "string", "enum": ["cronjob", "deployment"]},
            "schedule": {"type": "string"},
            "feeds": {"type": "array", "items": {"type": "object"}}
          }
        }
      }
    },
    "ingest": {
      "type": "object",
      "properties": {
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "prefix", "existingClaim", "storageClass", "size"],
          "properties": {
            "backend": {"type": "string", "enum": ["s3", "pvc"]},
            "prefix": {"type": "string", "minLength": 1},
            "existingClaim": {"type": "string"},
            "storageClass": {"type": "string"},
            "size": {"type": "string", "minLength": 1}
          }
        },
        "arxivHtmlFetcher": {
          "type": "object",
          "required": ["image", "replicas", "consumerGroup", "autoOffsetReset", "resources"],
          "properties": {
            "image": {"type": "string", "minLength": 1},
            "tag": {"type": "string"},
            "replicas": {"type": "integer", "const": 1},
            "consumerGroup": {"type": "string", "minLength": 1},
            "autoOffsetReset": {"type": "string", "enum": ["earliest", "latest"]},
            "maxRecordsPerLoop": {"type": "integer", "minimum": 0},
            "resources": {"type": "object"}
          }
        },
        "githubTarballFetcher": {
          "type": "object",
          "required": [
            "enabled",
            "image",
            "replicas",
            "consumerGroup",
            "allowedExtensions",
            "maxFileSizeBytes",
            "excludedTagPrefixes",
            "maxPollIntervalMilliseconds",
            "requestRatePerSecond",
            "requestBurst",
            "keda",
            "resources"
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "image": {"type": "string", "minLength": 1},
            "replicas": {"type": "integer", "minimum": 0},
            "consumerGroup": {"type": "string", "minLength": 1},
            "allowedExtensions": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "pattern": "^\\.[A-Za-z0-9]+$"}
            },
            "maxFileSizeBytes": {"type": "integer", "minimum": 1},
            "excludedTagPrefixes": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "maxPollIntervalMilliseconds": {"type": "integer", "minimum": 300000},
            "requestRatePerSecond": {"type": "number", "exclusiveMinimum": 0},
            "requestBurst": {"type": "integer", "minimum": 1},
            "keda": {
              "type": "object",
              "required": ["minReplicas", "maxReplicas", "lagThreshold"],
              "properties": {
                "minReplicas": {"type": "integer", "minimum": 0},
                "maxReplicas": {"type": "integer", "minimum": 1},
                "lagThreshold": {"type": "integer", "minimum": 1}
              }
            },
            "resources": {"type": "object"}
          }
        }
      }
    },
    "openreviewPoller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "venues", "live", "backfill", "runBackfill"],
      "properties": {
        "enabled": {"type": "boolean"},
        "venues": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 0
        },
        "tokenSecret": {"type": "string"},
        "tokenSecretKey": {"type": "string"},
        "live": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "schedule", "activeDeadlineSeconds", "state"],
          "properties": {
            "enabled": {"type": "boolean"},
            "schedule": {"type": "string", "minLength": 1},
            "activeDeadlineSeconds": {"type": "integer", "minimum": 60, "maximum": 86400},
            "state": {
              "type": "object",
              "additionalProperties": false,
              "required": ["storageClass", "size", "existingClaim"],
              "properties": {
                "storageClass": {"type": "string"},
                "size": {"type": "string", "minLength": 1},
                "existingClaim": {"type": "string"}
              }
            }
          }
        },
        "runBackfill": {"type": "boolean"},
        "backfill": {
          "type": "object",
          "additionalProperties": false,
          "required": ["datasetId", "revision", "splits", "activeDeadlineSeconds"],
          "properties": {
            "datasetId": {"type": "string"},
            "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "splits": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "maxRows": {
              "anyOf": [
                {"type": "string"},
                {"type": "integer", "minimum": 0}
              ]
            },
            "activeDeadlineSeconds": {"type": "integer", "minimum": 60, "maximum": 172800}
          }
        }
      }
    },
    "processor": {
      "type": "object",
      "required": ["fetcher", "curate", "iceberg"],
      "properties": {
        "fetcher": {
          "type": "object",
          "required": ["replicas", "pdfProcessingEnabled", "checkpoint", "canary"],
          "properties": {
            "replicas": {"type": "integer", "const": 1},
            "pdfProcessingEnabled": {"type": "boolean"},
            "checkpoint": {
              "type": "object",
              "required": ["existingClaim", "storageClass", "size", "recoveryPartitions", "snapshotSeconds"],
              "properties": {
                "existingClaim": {"type": "string"},
                "storageClass": {"type": "string"},
                "size": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"},
                "recoveryPartitions": {"type": "integer", "minimum": 1},
                "snapshotSeconds": {"type": "number", "exclusiveMinimum": 0}
              }
            },
            "canary": {
              "type": "object",
              "required": ["enabled", "replicas", "checkpoint"],
              "properties": {
                "enabled": {"type": "boolean"},
                "replicas": {"type": "integer", "const": 1},
                "checkpoint": {
                  "type": "object",
                  "required": ["existingClaim", "storageClass", "size", "recoveryPartitions", "snapshotSeconds"],
                  "properties": {
                    "existingClaim": {"type": "string"},
                    "storageClass": {"type": "string"},
                    "size": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"},
                    "recoveryPartitions": {"type": "integer", "minimum": 1},
                    "snapshotSeconds": {"type": "number", "exclusiveMinimum": 0}
                  }
                }
              }
            }
          }
        },
        "curate": {
          "type": "object",
          "required": ["replicas", "checkpoint"],
          "properties": {
            "replicas": {"type": "integer", "const": 1},
            "checkpoint": {
              "type": "object",
              "required": ["storageClass", "size", "recoveryPartitions", "snapshotSeconds"],
              "properties": {
                "storageClass": {"type": "string"},
                "size": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"},
                "recoveryPartitions": {"type": "integer", "minimum": 1},
                "snapshotSeconds": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          }
        },
        "iceberg": {
          "type": "object",
          "required": ["replicas", "checkpoint"],
          "properties": {
            "replicas": {"type": "integer", "const": 1},
            "checkpoint": {
              "type": "object",
              "required": ["existingClaim", "storageClass", "size", "recoveryPartitions", "snapshotSeconds"],
              "properties": {
                "existingClaim": {"type": "string"},
                "storageClass": {"type": "string"},
                "size": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"},
                "recoveryPartitions": {"type": "integer", "minimum": 1},
                "snapshotSeconds": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          }
        }
      }
    },
    "mixtureController": {"type": "object"},
    "seedLoader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "components"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "inProcess": {"type": "boolean", "const": true},
        "dryRun": {"type": "boolean"},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["pes2o", "redpajama-arxiv", "fineweb-edu", "stack-edu", "wayback"]
          }
        },
        "maxDocsPerComponent": {"type": "integer", "minimum": 0},
        "waybackMonths": {"type": "integer", "minimum": 1, "maximum": 120},
        "stateBucket": {"type": "string", "minLength": 1},
        "runId": {"type": "string"},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 60, "maximum": 604800},
        "hfTokenSecret": {"type": "string"},
        "hfTokenSecretKey": {"type": "string"},
        "hf_cache_pvc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size"],
          "properties": {
            "existingClaim": {"type": "string"},
            "storageClass": {"type": "string"},
            "size": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"}
          }
        },
        "resources": {"type": "object"},
        "fineweb_url_allowlist": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "ui": {"type": "object"},
    "keda": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "pollingInterval": {"type": "integer", "minimum": 1},
        "cooldownPeriod": {"type": "integer", "minimum": 1},
        "prometheus": {
          "type": "object",
          "properties": {
            "serverAddress": {"type": "string", "format": "uri"}
          }
        },
        "triggerAuthSecret": {"type": "string"},
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {"enabled": {"type": "boolean"}}
        }
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "prometheus": {
          "type": "object",
          "properties": {
            "serverAddress": {"type": "string", "format": "uri"}
          }
        },
        "serviceMonitor": {"type": "object"},
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "namespace", "labels"],
          "properties": {
            "enabled": {"type": "boolean"},
            "namespace": {"type": "string", "minLength": 1},
            "labels": {"type": "object"}
          }
        },
        "grafana": {"type": "object"},
        "tracing": {"type": "object"},
        "logs": {"type": "object"}
      }
    },
    "gatekeeper": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "enforcementAction": {"type": "string", "enum": ["deny", "dryrun", "warn"]},
        "minPollIntervalSeconds": {"type": "integer", "minimum": 1},
        "maxPollIntervalSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "crds": {
      "type": "object",
      "properties": {"install": {"type": "boolean"}}
    },
    "podSecurityContext": {"type": "object"},
    "containerSecurityContext": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "topologySpreadConstraints": {"type": "array"},
    "priorityClassName": {"type": "string"}
  }
}
