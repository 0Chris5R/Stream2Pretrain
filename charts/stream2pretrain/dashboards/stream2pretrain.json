{
  "title": "Stream2Pretrain",
  "uid": "stream2pretrain-main",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "tags": ["stream2pretrain", "kappa", "llm-pretraining"],
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(s2p_documents_emitted_total, namespace)",
        "refresh": 1,
        "current": {"text": "stream2pretrain", "value": "stream2pretrain"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput per stage (docs/sec)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (stage) (rate(s2p_documents_emitted_total{namespace=\"$namespace\"}[1m]))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Redpanda topic lag (records)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (topic, consumer_group) (kafka_consumergroup_lag{namespace=\"$namespace\"})",
          "legendFormat": "{{topic}} / {{consumer_group}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "KEDA replica count per ScaledObject",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "max by (scaledobject) (keda_scaler_metrics_value{namespace=\"$namespace\"})",
          "legendFormat": "{{scaledobject}}",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"$namespace\", deployment=~\".*processor.*|.*ingest.*\"}",
          "legendFormat": "{{deployment}} replicas",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "histogram",
      "title": "Quality score distribution (FineWeb-Edu)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (le) (rate(s2p_quality_score_bucket{namespace=\"$namespace\"}[5m]))",
          "format": "heatmap",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "SourceFeed poll success/error rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (source_feed, outcome) (rate(s2p_feed_poll_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "{{source_feed}} {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Iceberg writer flush latency p95 (s)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(s2p_iceberg_flush_seconds_bucket{namespace=\"$namespace\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Accepted post-training artifacts",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (kind, family) (increase(s2p_foundry_artifacts_total{status=\"accepted\"}[24h]))",
          "legendFormat": "{{kind}} / {{family}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Provider output tokens by role",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (provider, role) (rate(s2p_foundry_provider_tokens_total{direction=\"output\"}[5m]))",
          "legendFormat": "{{provider}} / {{role}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Foundry validation gates",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "s2p_foundry_validation_pass",
          "legendFormat": "{{task_family}} / {{gate}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1}}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Provider latency and first token p95",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 48},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (provider, role, le) (rate(s2p_foundry_provider_latency_seconds_bucket[5m])))",
          "legendFormat": "{{provider}} / {{role}} latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (provider, role, le) (rate(s2p_foundry_provider_time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "{{provider}} / {{role}} first token",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Provider quota remaining",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 56},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "s2p_foundry_quota_remaining{window=\"day\"}",
          "legendFormat": "{{provider}} / {{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Post-training queue",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 56},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "s2p_foundry_queued_candidates", "refId": "A"}
      ]
    }
  ]
}
