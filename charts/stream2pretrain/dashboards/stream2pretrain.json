{
  "title": "Stream2Pretrain",
  "uid": "stream2pretrain-main",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "tags": ["stream2pretrain", "kappa", "llm-pretraining"],
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(s2p_documents_emitted_total, namespace)",
        "refresh": 1,
        "current": {"text": "stream2pretrain", "value": "stream2pretrain"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput per stage (docs/sec)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (stage) (rate(s2p_documents_emitted_total{namespace=\"$namespace\"}[1m]))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Redpanda topic lag (records)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (topic, consumer_group) (kafka_consumergroup_lag{namespace=\"$namespace\"})",
          "legendFormat": "{{topic}} / {{consumer_group}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "KEDA replica count per ScaledObject",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "max by (scaledobject) (keda_scaler_metrics_value{namespace=\"$namespace\"})",
          "legendFormat": "{{scaledobject}}",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"$namespace\", deployment=~\".*processor.*|.*ingest.*\"}",
          "legendFormat": "{{deployment}} replicas",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "histogram",
      "title": "Quality score distribution (FineWeb-Edu)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (le) (rate(s2p_quality_score_bucket{namespace=\"$namespace\"}[5m]))",
          "format": "heatmap",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Decon flag rate (last 5m)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(s2p_decon_flagged_total{namespace=\"$namespace\"}[5m])) / clamp_min(sum(rate(s2p_decon_checked_total{namespace=\"$namespace\"}[5m])), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Decon flags by benchmark",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (benchmark) (rate(s2p_decon_flagged_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "{{benchmark}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "SourceFeed poll success/error rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (source_feed, outcome) (rate(s2p_feed_poll_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "{{source_feed}} {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Iceberg writer flush latency p95 (s)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(s2p_iceberg_flush_seconds_bucket{namespace=\"$namespace\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    }
  ]
}
