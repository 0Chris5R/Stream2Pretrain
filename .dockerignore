# Stream2Pretrain - shared dockerignore for all component images.

# VCS
.git
.gitignore
.gitattributes

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db
*.swp

# Python
__pycache__
*.pyc
*.pyo
.venv
venv
.eggs
*.egg-info
dist
build
.mypy_cache
.ruff_cache
.pytest_cache

# Node
node_modules
.next
.turbo
out

# Local env / secrets
.env
.env.*
*.pem
*.key

# Lecture / docs / large local artifacts the runtime never needs
lecture_slides
docs
RESEARCH.md
README.md
CLAUDE.md
SOURCES.md

# Test fixtures and notebooks
tests
*.ipynb

# Helm / Terraform state (built separately)
charts
infra
helmfile.yaml

# Compose dev stack
docker-compose.dev.yml
