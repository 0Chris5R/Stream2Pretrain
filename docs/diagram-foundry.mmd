---
title: Stream2Pretrain -- Post-Training Foundry
---
flowchart TD

    %% ── Input ─────────────────────────────────────────────────────
    IN["docs.curated\n(posttrain_candidate papers)"]

    %% ── Daily Queue ───────────────────────────────────────────────
    subgraph SCHED["Daily Scheduler  (StatefulSet)"]
        direction TB
        QU["Durable ranked queue\n24h candidate snapshot"]
        BU["Immutable PaperBundle\nGold record + scientific artifact"]
        QU -->|"ranked by posttrain\nsuitability score"| BU
    end

    %% ── Generation Pipeline ───────────────────────────────────────
    subgraph GEN["Generation Pipeline  (Qwen3.8-27B · Hetzner Inference)"]
        direction TB
        EG["Evidence Graph\n6-pass extraction"]
        TP["Task Proposal\n+ answerability audit"]
        SV["Solver\nindependent trajectories"]
        VC["Verifier Compiler\ndeterministic checks"]
        AT["Adversarial & Mutation\nvalidation"]
        EG --> TP --> SV --> VC --> AT
    end

    %% ── Output ────────────────────────────────────────────────────
    subgraph OUT["Validated Output"]
        direction LR
        SP["SFT Pool\n(train 80% · benchmark 20%)"]
        RP["RL Pool\n(train 80% · benchmark 20%)"]
    end

    HR["Human Review\n(Web Cockpit · named approval)"]

    subgraph STORE["Storage"]
        direction LR
        MG["MinIO Gold\nSigned packages"]
        IC["Iceberg\nAudit tables"]
    end

    %% ── Flow ──────────────────────────────────────────────────────
    IN --> QU
    BU --> EG

    AT -->|"SFT: plausible trajectory"| SP
    AT -->|"RL: all checks pass"| RP

    SP & RP --> HR
    HR -->|"approved"| STORE
    HR -->|"rejected"| IC

