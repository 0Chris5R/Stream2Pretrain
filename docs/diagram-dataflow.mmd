---
title: Stream2Pretrain -- Data Flow
---
flowchart LR

    %% ── Sources ───────────────────────────────────────────────────
    AX["arXiv"]
    HF["Hugging Face\nModel- & Dataset-Cards"]

    %% ── Ingestion ─────────────────────────────────────────────────
    LA["Licence Admission\npermissive / posttrain-only / quarantined"]
    QUAR["Quarantine\nvisible in license_admissions only"]
    MB["MinIO Bronze\nImmutable gzip source data"]

    %% ── Processing ────────────────────────────────────────────────
    subgraph RP["Redpanda  (underlying transport — all arrows are Kafka topics)"]
        direction LR
        FE["Fetcher  (Bytewax)\nText extraction · SilverRecord"]

        subgraph CUB["Curator  (Bytewax · StatefulSet)"]
            direction LR
            CUD["Deterministic checks\nLanguage · PII · Deduplication"]
            CL["4x ModernBERT Classifiers\nQuality · Math · Posttrain Suitability"]
            CUD -->|"passed"| CL
        end

        IW["Iceberg Writer  (PyIceberg)"]
    end

    %% ── Persistence ───────────────────────────────────────────────
    MG["MinIO Gold\nIceberg V2 Parquet"]
    PO["Polaris\nIceberg REST Catalog"]

    %% ── Serving ───────────────────────────────────────────────────
    DK["DuckDB API\nServing layer · paginated"]
    UI["Web Cockpit  (Next.js)\nDashboard · Documents · Datasets"]

    %% ── Flow ──────────────────────────────────────────────────────
    AX & HF --> LA

    LA -->|"quarantined\n(no body fetch)"| QUAR
    LA -->|"license.admissions\n(all documents)"| IW
    LA -->|"admitted /\nposttrain-only"| MB

    MB -->|"raw.fetched"| FE
    FE -->|"docs.normalized"| CUD

    CUD -->|"rejected\ncuration.decisions"| IW
    CL -->|"curation.decisions\n+ docs.curated (if passed)"| IW

    IW -->|"Parquet data"| MG
    IW -->|"table metadata & snapshots"| PO

    DK -->|"1. where is snapshot?"| PO
    PO -->|"2. metadata path"| DK
    DK -->|"3. read Parquet"| MG
    MG -->|"4. data"| DK

    DK --> UI

