# Stream2Pretrain - example environment for local dev.
# Copy to `.env` and fill in secrets. NEVER commit `.env`.

# Runtime mode: dev | prod. Affects topic partition counts and log verbosity.
S2P_ENV=dev

# Logging (structlog). One of: DEBUG INFO WARNING ERROR.
LOG_LEVEL=INFO

# Redpanda / Kafka API. Comma-separated bootstrap list.
REDPANDA_BROKERS=localhost:9092

# MinIO / S3-compatible object store.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Iceberg REST catalog. In dev points at a local SQLite-backed pyiceberg
# catalog by default; in prod this is the in-cluster Polaris service URL.
ICEBERG_CATALOG_URI=http://localhost:8181/api/catalog

# Source-feed credentials.
# GitHub PAT - required for the events poller (anon GitHub REST is 60 req/h).
GITHUB_TOKEN=
# Hugging Face token - optional, raises the 5-min quota on the Hub.
HF_TOKEN=

# OpenTelemetry exporter (Tempo / OTLP collector).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
